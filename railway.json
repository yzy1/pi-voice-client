{
  "build": {
    "builder": "RAILPACK",
    "config": {
      "pythonVersion": "3.11",
      "installCommand": "pip install -r server/requirements.txt",
      "buildCommand": "echo 'Building...'",
      "startCommand": "uvicorn server.main:app --host 0.0.0.0 --port $PORT"
    }
  },
  "deploy": {
    "startCommand": "uvicorn server.main:app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE"
  }
}
